<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F9"
    android:fillViewport="true"
    tools:context=".Avgfatsnf">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/teal_700"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/average" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average FAT &amp; SNF"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Batch Milk Collection Calculator"
                        android:textColor="#B2DFDB"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Summary & Standard Rate Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Standard Rate -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/standard_rate"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="#242F4D"
                    app:prefixText="₹"
                    app:prefixTextColor="#242F4D">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStRateAv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- FAT Ratio Segmented RadioGroup -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/fat_ratio"
                    android:textColor="#5A6A85"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/radioGroupRatio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <RadioButton
                        android:id="@+id/radio5248"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/segmented_radio_left"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:text="52:48"
                        android:textColor="@color/segmented_radio_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <RadioButton
                        android:id="@+id/radio5050"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/segmented_radio_middle"
                        android:button="@null"
                        android:gravity="center"
                        android:text="50:50"
                        android:textColor="@color/segmented_radio_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <RadioButton
                        android:id="@+id/radio6040"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/segmented_radio_right"
                        android:button="@null"
                        android:gravity="center"
                        android:text="60:40"
                        android:textColor="@color/segmented_radio_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </RadioGroup>

                <!-- Date & Shift Info Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvShift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E0F2F1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="SHIFT"
                        android:textColor="@color/teal_700"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Batch Totals & Averages -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F8FAFC"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_milk"
                            android:textColor="#475569"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvTMlk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/teal_700"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/avg_fat"
                            android:textColor="#475569"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvAvgFat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/teal_700"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Avg SNF:"
                            android:textColor="#475569"
                            android:textSize="13sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/tvAvgSnf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/teal_700"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total:"
                            android:textColor="#475569"
                            android:textSize="13sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/tvAvgTAmt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/teal_700"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 10 Rows Input Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Batch Entries (1 - 10)"
                    android:textColor="@color/teal_700"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Table Header Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="QTY (L)"
                        android:textColor="#5A6A85"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="FAT %"
                        android:textColor="#5A6A85"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="SNF %"
                        android:textColor="#5A6A85"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:text="Rate"
                        android:textColor="#5A6A85"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:gravity="end"
                        android:text="Total (₹)"
                        android:textColor="#5A6A85"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty1" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat1" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf1" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate1" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs1" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate2" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs2" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty3" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat3" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf3" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate3" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs3" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty4" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat4" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf4" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate4" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs4" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty5" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat5" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf5" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate5" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs5" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 6 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty6" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat6" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf6" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate6" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs6" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 7 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <EditText android:id="@+id/etQty7" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginEnd="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etFat7" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <EditText android:id="@+id/etSnf7" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="42dp" android:layout_marginStart="4dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="8dp" android:hint="@string/snf" android:inputType="numberDecimal" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvRate7" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="center" android:textColor="#212121" />
                    <TextView android:id="@+id/tvRs7" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="12sp" android:gravity="end" android:textColor="#212121" android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 8 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="6dp">
