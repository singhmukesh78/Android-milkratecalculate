<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F9"
    android:fillViewport="true"
    tools:context=".AvgFatClr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/teal_700"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/average_1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Average FAT &amp; CLR"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Batch Milk Collection Calculator"
                        android:textColor="#E0F2F1"
                        android:textSize="11sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Summary & Standard Rate Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Top Row: Standard Rate & Shift Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/standard_rate"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/teal_700"
                        app:prefixText="₹"
                        app:prefixTextColor="@color/teal_700">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStRateAv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date & Shift Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E0F2F1"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tvDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/date"
                            android:textColor="#004D40"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvShift"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/shift"
                            android:textColor="#004D40"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Batch Summary Dashboard -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Stat 1: Total Milk -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="#F1F5F9"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_milk"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTMlk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- Stat 2: Avg Rate -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:background="#F1F5F9"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/avg_rate"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹ "
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/tvRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Stat 3: Avg FAT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:background="#F1F5F9"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/avg_fat"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAvgFat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <!-- Stat 4: Avg CLR -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:background="#F1F5F9"
                        android:orientation="vertical"
                        android:padding="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/avg_clr"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAvgClr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Stat 5: Highlighted Total Amount Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:cardBackgroundColor="#E0F2F1"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/teal_700"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_amount"
                            android:textColor="#004D40"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹ "
                                android:textColor="#004D40"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:id="@+id/tvAvgTAmt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="#004D40"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5 Rows Input Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Batch Entries (1 - 5)"
                    android:textColor="@color/teal_700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <!-- Table Header Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="QTY (L)"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="FAT %"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="CLR"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:text="Rate"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:gravity="end"
                        android:text="Total (₹)"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginBottom="4dp">
                    <EditText android:id="@+id/etQty1" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginEnd="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etFat1" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etClr1" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginStart="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/clr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <TextView android:id="@+id/tvRate1" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="center" android:textColor="#475569" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/tvRs1" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="end" android:textColor="#0F172A" android:textStyle="bold" tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginBottom="4dp">
                    <EditText android:id="@+id/etQty2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginEnd="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etFat2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etClr2" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginStart="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/clr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <TextView android:id="@+id/tvRate2" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="center" android:textColor="#475569" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/tvRs2" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="end" android:textColor="#0F172A" android:textStyle="bold" tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginBottom="4dp">
                    <EditText android:id="@+id/etQty3" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginEnd="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etFat3" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etClr3" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginStart="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/clr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <TextView android:id="@+id/tvRate3" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="center" android:textColor="#475569" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/tvRs3" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="end" android:textColor="#0F172A" android:textStyle="bold" tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginBottom="4dp">
                    <EditText android:id="@+id/etQty4" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginEnd="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etFat4" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etClr4" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginStart="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/clr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <TextView android:id="@+id/tvRate4" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="center" android:textColor="#475569" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/tvRs4" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="end" android:textColor="#0F172A" android:textStyle="bold" tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <EditText android:id="@+id/etQty5" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginEnd="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/ltr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etFat5" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginHorizontal="2dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/fat" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <EditText android:id="@+id/etClr5" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="36dp" android:layout_marginStart="3dp" android:background="@drawable/batch_input_bg" android:paddingHorizontal="6dp" android:hint="@string/clr" android:inputType="numberDecimal" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:autofillHints="none" />
                    <TextView android:id="@+id/tvRate5" android:layout_width="0dp" android:layout_weight="1.1" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="center" android:textColor="#475569" tools:ignore="HardcodedText" />
                    <TextView android:id="@+id/tvRs5" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:text="0.00" android:textSize="11sp" android:gravity="end" android:textColor="#0F172A" android:textStyle="bold" tools:ignore="HardcodedText" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons & PDF Report -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btCalculate"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1.2"
                android:onClick="btnCalculateAvgFatClr"
                android:text="@string/calculate"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/teal_700"
                app:cornerRadius="10dp"
                app:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btClr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:onClick="btnOnClickClear"
                android:text="@string/clear"
                android:textColor="@color/teal_700"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:strokeColor="@color/teal_700"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btDownloadReport"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:onClick="downloadPdfReport"
                android:text="PDF"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/teal_700"
                app:cornerRadius="10dp"
                app:elevation="2dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="start"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- AdMob Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:adSize="BANNER"
                app:adUnitId="@string/banner_ad_unit_id_Test" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
